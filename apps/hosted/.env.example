# Contracts §7. Copy to .env.local; never commit real values.

# Server only: the Helius devnet URL carries a key. Never prefix it with NEXT_PUBLIC_.
RPC_URL=
# The browser only sends, through the public endpoint.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# The deployment's HTTPS origin, no trailing slash. A wallet refuses anything but HTTPS.
NEXT_PUBLIC_BASE_URL=
# The Neon Postgres connection string.
DATABASE_URL=
# The `Authorization` value Helius sends to `/hooks/helius`.
HELIUS_WEBHOOK_SECRET=
# `program` or `transfers` (the cut passed: program).
PAY_STRATEGY=program
