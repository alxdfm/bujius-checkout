{
  "name": "@bujius/checkout-react",
  "version": "0.0.0",
  "description": "React components for Bujius Checkout: the QR of a Solana Pay transaction request.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --sourcemap --target es2022",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "dependencies": {
    "@solana/pay": "~0.2.6",
    "@solana/web3.js": "~1.98.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "~19.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
