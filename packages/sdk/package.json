{
  "name": "@bujius/checkout-sdk",
  "version": "0.1.0",
  "description": "Atomic payment splits on Solana: one transaction pays the merchant and every partner, with the split enforced on-chain.",
  "license": "MIT",
  "homepage": "https://github.com/alxdfm/bujius-checkout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxdfm/bujius-checkout.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alxdfm/bujius-checkout/issues"
  },
  "keywords": [
    "solana",
    "payments",
    "split",
    "usdc",
    "solana-pay",
    "anchor"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/pay": "~0.2.6",
    "@solana/spl-token": "~0.4.15",
    "@solana/web3.js": "~1.98.4"
  }
}
