{
  "name": "bujius-checkout",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm --filter './apps/*' --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm --filter './packages/*' --if-present run build",
    "test:program": "anchor test",
    "smoke": "tsx scripts/smoke-pay.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
